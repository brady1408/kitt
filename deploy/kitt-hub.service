[Unit]
Description=KITT hub (Claude Code console)
After=network.target

[Service]
Type=simple
WorkingDirectory=/home/brady/ws/kitt
Environment=PATH=/home/brady/.local/bin:/home/brady/.bun/bin:/usr/local/bin:/usr/bin:/bin
ExecStart=/home/brady/.bun/bin/bun run hub/src/main.ts
Restart=on-failure
RestartSec=3

[Install]
WantedBy=default.target
