[Unit]
Description=KITT hub (Claude Code console)
After=network.target

[Service]
Type=simple
# %h is the user's home directory. Adjust the clone location and bun path if yours differ.
WorkingDirectory=%h/ws/kitt
Environment=PATH=%h/.local/bin:%h/.bun/bin:/usr/local/bin:/usr/bin:/bin
# Optional: Environment=KITT_WORKDIR=%h/projects  KITT_OPERATOR=Michael  KITT_PORT=7331
ExecStart=%h/.bun/bin/bun run hub/src/main.ts
Restart=on-failure
RestartSec=3

[Install]
WantedBy=default.target
